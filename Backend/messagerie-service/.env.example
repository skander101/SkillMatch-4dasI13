# Variables d'environnement — messagerie-service
# Copier ce fichier vers .env, adapter les valeurs, NE PAS commiter .env
# Spring Boot ne charge PAS .env automatiquement.
# Sous Linux/Mac : set -a; . ./.env; set +a
# Sous Windows PowerShell :
#   Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }

SERVER_PORT=8086

# MySQL (XAMPP par défaut)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=messagerie_db
MYSQL_USER=root
MYSQL_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT — DOIT être identique à la valeur de JWT_SECRET dans commun-service
# Ce service valide uniquement les tokens, il n'en génère pas.
JWT_SECRET=

# URL du commun-service (fallback uniquement pour résoudre l'id via GET /skillmatch/auth/me)
# Valeur par défaut : http://localhost:8087 (port documenté dans Backend/README.md)
# Supprimer ce fallback lorsque commun-service ajoute id/userId dans le JWT.
COMMUN_SERVICE_URL=http://localhost:8087

# Eureka
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_REGISTER=false
EUREKA_FETCH=false
